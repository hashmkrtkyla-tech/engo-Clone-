import 'package:flutter/material.dart';

void main() {
  runApp(const EngoApp());
}

class EngoApp extends StatefulWidget {
  const EngoApp({super.key});

  @override
  State<EngoApp> createState() => _EngoAppState();
}

class _EngoAppState extends State<EngoApp> {
  bool isDarkMode = false;

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Engo Clone',
      theme: isDarkMode ? ThemeData.dark() : ThemeData.light().copyWith(
        primaryColor: Colors.blueAccent,
        colorScheme: ColorScheme.fromSeed(seedColor: Colors.blueAccent),
      ),
      home: MainNavigationScreen(
        isDarkMode: isDarkMode,
        onThemeChanged: (value) {
          setState(() {
            isDarkMode = value;
          });
        },
      ),
    );
  }
}

class MainNavigationScreen extends StatefulWidget {
  final bool isDarkMode;
  final ValueChanged<bool> onThemeChanged;

  const MainNavigationScreen({
    super.key,
    required this.isDarkMode,
    required this.onThemeChanged,
  });

  @override
  State<MainNavigationScreen> createState() => _MainNavigationScreenState();
}

class _MainNavigationScreenState extends State<MainNavigationScreen> {
  int _currentIndex = 0;
  int streakDays = 5; 
  int userXP = 120; 
  final int targetXP = 300;

  final List<Map<String, String>> savedWords = [
    {'word': 'Forest', 'translation': 'غابة', 'example': 'The lion lives in the forest.'},
    {'word': 'Journey', 'translation': 'رحلة', 'example': 'A long journey starts with a single step.'},
    {'word': 'Treasure', 'translation': 'كنز', 'example': 'They found the golden treasure.'},
  ];

  void _addWordToVocabulary(String word, String translation, String example) {
    setState(() {
      if (!savedWords.any((element) => element['word'] == word)) {
        savedWords.add({
          'word': word,
          'translation': translation,
          'example': example,
        });
      }
    });
  }

  @override
  Widget build(BuildContext context) {
    final List<Widget> screens = [
      StoriesTab(
        streakDays: streakDays,
        userXP: userXP,
        targetXP: targetXP,
        onWordSaved: _addWordToVocabulary,
        onStoryCompleted: () {
          setState(() {
            userXP += 50; 
            if (userXP >= targetXP) {
              userXP = 0; 
            }
          });
        },
      ),
      VocabularyTab(savedWords: savedWords),
      ProfileTab(
        isDarkMode: widget.isDarkMode,
        onThemeChanged: widget.onThemeChanged,
        streakDays: streakDays,
        totalWords: savedWords.length,
      ),
    ];

    return Scaffold(
      body: SafeArea(child: screens[_currentIndex]),
      bottomNavigationBar: BottomNavigationBar(
        currentIndex: _currentIndex,
        onTap: (index) {
          setState(() {
            _currentIndex = index;
          });
        },
        selectedItemColor: Colors.blueAccent,
        unselectedItemColor: Colors.grey,
        items: const [
          BottomNavigationBarItem(icon: Icon(Icons.book), label: 'القصص'),
          BottomNavigationBarItem(icon: Icon(Icons.style), label: 'مفرداتي'),
          BottomNavigationBarItem(icon: Icon(Icons.person), label: 'حسابي'),
        ],
      ),
    );
  }
}


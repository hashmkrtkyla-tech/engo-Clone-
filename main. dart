class ReaderScreen extends StatefulWidget {
  final Map<String, dynamic> story;
  final Function(String, String, String) onWordSaved;
  final VoidCallback onStoryCompleted;

  const ReaderScreen({
    super.key,
    required this.story,
    required this.onWordSaved,
    required this.onStoryCompleted,
  });

  @override
  State<ReaderScreen> createState() => _ReaderScreenState();
}

class _ReaderScreenState extends State<ReaderScreen> {
  void _showWordTranslation(BuildContext context, String word) {
    final cleanedWord = word.toLowerCase().replaceAll(RegExp(r'[^\w\s]'), '');
    final translations = widget.story['translations'] as Map<String, dynamic>;

    if (translations.containsKey(cleanedWord)) {
      final info = translations[cleanedWord]!;
      showModalBottomSheet(
        context: context,
        shape: const RoundedRectangleBorder(borderRadius: BorderRadius.vertical(top: Radius.circular(24))),
        builder: (context) {
          return Padding(
            padding: const EdgeInsets.all(24.0),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(word, style: const TextStyle(fontSize: 24, fontWeight: FontWeight.bold, color: Colors.blueAccent)),
                const Divider(),
                const Text('الترجمة العربية:', style: TextStyle(color: Colors.grey, fontSize: 12)),
                Text(info['ar']!, style: const TextStyle(fontSize: 20, fontWeight: FontWeight.bold)),
                const SizedBox(height: 12),
                const Text('مثال:', style: TextStyle(color: Colors.grey, fontSize: 12)),
                Text(info['ex']!, style: const TextStyle(fontSize: 14, fontStyle: FontStyle.italic)),
                const SizedBox(height: 20),
                SizedBox(
                  width: double.infinity,
                  child: ElevatedButton(
                    style: ElevatedButton.styleFrom(backgroundColor: Colors.blueAccent),
                    onPressed: () {
                      widget.onWordSaved(cleanedWord, info['ar']!, info['ex']!);
                      Navigator.pop(context);
                    },
                    child: const Text('حفظ في مفرداتي', style: TextStyle(color: Colors.white)),
                  ),
                ),
              ],
            ),
          );
        },
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    final List<String> words = widget.story['words'] as List<String>;
    return Scaffold(
      appBar: AppBar(title: Text(widget.story['title']), backgroundColor: widget.story['levelColor']),
      body: Padding(
        padding: const EdgeInsets.all(20.0),
        child: Column(
          children: [
            Expanded(
              child: Wrap(
                spacing: 6.0,
                runSpacing: 10.0,
                children: words.map((word) {
                  final cleaned = word.toLowerCase().replaceAll(RegExp(r'[^\w\s]'), '');
                  final isInteractive = widget.story['translations'].containsKey(cleaned);
                  return GestureDetector(
                    onTap: () => _showWordTranslation(context, word),
                    child: Text(
                      '$word ',
                      style: TextStyle(fontSize: 20, color: isInteractive ? Colors.blueAccent : null, fontWeight: isInteractive ? FontWeight.bold : FontWeight.normal),
                    ),
                  );
                }).toList(),
              ),
            ),
            ElevatedButton(
              style: ElevatedButton.styleFrom(backgroundColor: Colors.green, minimumSize: const Size(double.infinity, 50)),
              onPressed: () {
                widget.onStoryCompleted();
                Navigator.pop(context);
              },
              child: const Text('أنهيت القراءة اليوم! 🏆', style: TextStyle(color: Colors.white, fontSize: 18)),
            ),
          ],
        ),
      ),
    );
  }
}

class VocabularyTab extends StatefulWidget {
  final List<Map<String, String>> savedWords;
  const VocabularyTab({super.key, required this.savedWords});

  @override
  State<VocabularyTab> createState() => _VocabularyTabState();
}

class _VocabularyTabState extends State<VocabularyTab> {
  int currentCardIndex = 0;
  bool showTranslation = false;

  @override
  Widget build(BuildContext context) {
    if (widget.savedWords.isEmpty) {
      return const Center(child: Text('قاموسك فارغ حالياً!'));
    }
    final currentWord = widget.savedWords[currentCardIndex];
    return Padding(
      padding: const EdgeInsets.all(16.0),
      child: Column(
        children: [
          Expanded(
            child: GestureDetector(
              onTap: () => setState(() => showTranslation = !showTranslation),
              child: Container(
                width: double.infinity,
                decoration: BoxDecoration(color: Colors.blue[50], borderRadius: BorderRadius.circular(24)),
                child: Center(
                  child: Text(
                    showTranslation ? currentWord['translation']! : currentWord['word']!,
                    style: const TextStyle(fontSize: 32, fontWeight: FontWeight.bold, color: Colors.blueAccent),
                  ),
                ),
              ),
            ),
          ),
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceEvenly,
            children: [
              ElevatedButton(onPressed: () => setState(() => currentCardIndex = (currentCardIndex - 1 + widget.savedWords.length) % widget.savedWords.length), child: const Text('السابق')),
              ElevatedButton(onPressed: () => setState(() => currentCardIndex = (currentCardIndex + 1) % widget.savedWords.length), child: const Text('التالي')),
            ],
          ),
        ],
      ),
    );
  }
}

